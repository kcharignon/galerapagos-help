# Image de production : une page statique autonome (script et styles en ligne, aucune ressource externe).
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Tout est dans le fichier : aucun script ni style externe, aucune requête sortante.
		Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}

	handle /healthz {
		respond "ok" 200
	}

	# L'APK de débogage construit par `make android` (volume ./dist), installable depuis le téléphone.
	handle /galerapagos.apk {
		root * /srv/dist
		rewrite * /galerapagos-debug.apk
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment; filename=galerapagos.apk"
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
